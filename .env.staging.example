# GHCR image location. The owner must be lowercase because GHCR image names are lowercase.
GHCR_OWNER=your-github-user-or-org
# Use an immutable tag that identifies the current working-tree build; never use only `latest`.
STAGING_TAG=staging-c5-YYYYMMDD-01

# Public DNS name that resolves directly to the VPS public IPv4 address.
LIKECORD_STAGING_DOMAIN=staging.example.com

# Staging database password. Use a unique URL-safe value (for example, a random hex string).
POSTGRES_PASSWORD=CHANGE_ME_USE_A_UNIQUE_URL_SAFE_RANDOM_VALUE

# JWT signing secrets. Generate two different high-entropy values; never reuse development values.
JWT_ACCESS_SECRET=CHANGE_ME_GENERATE_UNIQUE_ACCESS_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_GENERATE_UNIQUE_REFRESH_SECRET

# Shared coturn HMAC secret. It must match the API and coturn service values.
TURN_SECRET=CHANGE_ME_GENERATE_UNIQUE_TURN_SECRET
# Dedicated Link Preview cache HMAC secret (at least 32 bytes; do not reuse JWT/TURN).
LINK_PREVIEW_CACHE_HMAC_SECRET=CHANGE_ME_GENERATE_UNIQUE_LINK_PREVIEW_SECRET
# Public IPv4 assigned to the VPS. Coturn needs this because it runs behind Docker NAT.
TURN_EXTERNAL_IP=203.0.113.10

# Upload storage: `local` is the safe diagnostic default and persists only in likecord_staging_uploads.
# Set to `r2` only after supplying all R2 values below for a staging-only media bucket.
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=likecord-staging-media
R2_ENDPOINT=
# Presigned URL lifetimes in seconds, used only with STORAGE_DRIVER=r2.
R2_PRESIGNED_UPLOAD_TTL=300
R2_PRESIGNED_DOWNLOAD_TTL=600
