# LOCAL DEVELOPMENT ONLY. Copy to .env, keep private, and replace every
# CHANGE_ME value with a different random value before starting Compose.
# This file's database password is a known local-only default; never publish
# this Compose stack on an Internet-facing host.
# development | production | test
NODE_ENV=development

# Database (PostgreSQL)
# Connection string format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# In local Compose: host=postgres, user=likecord, password=likecord_password.
# A host-side Prisma command must instead use 127.0.0.1 as the host.
DATABASE_URL=postgresql://likecord:likecord_password@postgres:5432/likecord

# Redis (cache, presence, rate-limiting, voice state)
# In Docker: host=redis
REDIS_URL=redis://redis:6379

# Required by the current API LinkPreviewModule at startup.
# Dedicated random secret, at least 32 bytes; never reuse JWT/TURN/R2 secrets.
# Generate independently: openssl rand -base64 32
LINK_PREVIEW_CACHE_HMAC_SECRET=

# API Port (default: 3001)
API_PORT=3001

# CORS allowed origin (comma-separated, or leave empty for same-origin)
# In production: https://your-domain.com
CORS_ORIGIN=

# TURN server secret (coturn time-limited auth via HMAC-SHA1)
# Must match static-auth-secret in apps/turn/turnserver.conf
# Generate: openssl rand -base64 32
TURN_SECRET=change-me-in-production

# TURN server hostname (default: localhost)
TURN_HOST=localhost

# JWT secrets for access and refresh tokens
# Generate: openssl rand -base64 32 (use different values for each)
JWT_ACCESS_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-in-production-different

# Local upload directory (used when S3 is not configured — file-system storage)
UPLOAD_DIR=./uploads

# Storage driver (local | r2)
STORAGE_DRIVER=local

# Cloudflare R2 (S3-compatible object storage)
# Required only when STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=likecord-media
R2_ENDPOINT=
# Presigned URL time-to-live (seconds)
R2_PRESIGNED_UPLOAD_TTL=300
R2_PRESIGNED_DOWNLOAD_TTL=600

# Application origin (comma-separated for multiple)
APP_ORIGIN=https://localhost

# Optional Web build-time overrides; set in the Web build environment, not only
# this API env_file. Leave unset for same-origin API and normal media routing.
# NEXT_PUBLIC_API_URL=https://example.com
# NEXT_PUBLIC_DEBUG_ATTACHMENTS=false
# NEXT_PUBLIC_WEBRTC_FORCE_RELAY=false

# Rate limits (optional, overrides defaults)
# RATE_LIMIT_LOGIN_POINTS=5
# RATE_LIMIT_LOGIN_WINDOW=60
# RATE_LIMIT_REGISTER_POINTS=3
# RATE_LIMIT_REGISTER_WINDOW=3600
# RATE_LIMIT_REFRESH_POINTS=10
# RATE_LIMIT_REFRESH_WINDOW=60
